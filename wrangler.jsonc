{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "browser-run-hello-world",
  "main": "index.js",
  // Set this to today's date when you actually deploy
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "MYBROWSER"
  }
}
